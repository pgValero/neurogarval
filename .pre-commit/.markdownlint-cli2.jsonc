// markdownlint-cli2 configuration for the repository Markdown (README.md,
// AGENTS.md, CONTRIBUTING.md, TODO.md).
//
// The rule set is the default one with a few exceptions, and every exception
// is here with its reason (the same policy as .pre-commit/.stylelintrc.json
// and .pre-commit/eslint.config.js).
{
  "config": {
    "default": true,

    // The documentation uses long prose lines on purpose (one sentence per
    // line, re-wrapped by hand), so the line length is not enforced.
    "MD013": false,

    // README.md uses two H1 headings on purpose (business intro, then the
    // reusable project behind the site), so the single-title rule is off.
    "MD025": false,
    "MD041": false,
  }
}
